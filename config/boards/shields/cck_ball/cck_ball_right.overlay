#include "cck_ball.dtsi"

/* This provides the codes for X/Y movement (INPUT_REL_X) */
#include <zephyr/dt-bindings/input/input-event-codes.h>

/* This provides the mouse button and movement behaviors if you need them later */
#include <dt-bindings/zmk/pointing.h>

&default_transform {
    col-offset = <6>;
}; 

&kscan0 {
	col-gpios
		= <&gpio1 15 GPIO_ACTIVE_HIGH>
        , <&gpio0 9 GPIO_ACTIVE_HIGH>
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        , <&gpio1 11 GPIO_ACTIVE_HIGH>
        , <&gpio1 4 GPIO_ACTIVE_HIGH>
        , <&gpio1 6 GPIO_ACTIVE_HIGH>
		;
};

// trackball
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 17)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
		res-cpi = <800>;
        motion-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	    zephyr,axis-x = <INPUT_REL_X>;
        zephyr,axis-y = <INPUT_REL_Y>;
        // automouse-layer = <3>;
    };
};


//RGB bus
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        /* SPI */
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* WS2812 */
        chain-length = <27>; /* number of LEDs */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};

// enable right encoder
&right_encoder {
	compatible = "alps,ec11";
    a-gpios = <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    b-gpios = <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	status = "okay";
};


/ {
    /* 1. Combine everything into ONE listener for the trackball. 
       Multiple listeners on the same device can cause unpredictable behavior.
    */
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        /* Snipe Mode (Layer 4) */
        snipe_mode {
            layers = <4>;
            input-processors = <&snipe_scaler 1 3>; 
        };
        
        /* Vertical Scroll Mode (Layer 1) */
        scroll_mode {
            layers = <1>;
            /* We use the scaler to zero out X and keep Y at 1:1, then map Y to Wheel */
            input-processors = <&xy_to_scroll_mapper>;
        };
    };
	
	/* 2. The Input Listener: This is the 'Brain' */
    encoder_listener {
        compatible = "zmk,input-listener";
        device = <&right_encoder>;
        
        /* This mapper turns the encoder's 'ticks' into 'scrolls' */
        input-processors = <&encoder_to_wheel_mapper>;
    };

    /* 2. All input processors should ideally live inside this block 
    */
    input_processors {
        snipe_scaler: snipe_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_X INPUT_REL_Y>;
            track-remainders;
        };

		xy_to_scroll_mapper: xy_to_scroll_mapper {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_REL>;
            /* The map works in pairs: <Original Target> */
            map = <INPUT_REL_X INPUT_REL_HWHEEL>, <INPUT_REL_Y INPUT_REL_WHEEL>;
        };
		
		encoder_to_wheel_mapper: encoder_to_wheel_mapper {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_REL>;
            /* Map the relative signal of the encoder to the Vertical Wheel axis */
            map = <INPUT_REL_MISC INPUT_REL_WHEEL>;
        };
    };
};
