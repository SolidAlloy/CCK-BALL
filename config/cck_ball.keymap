#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/* Override the default layer-tap behavior */
&lt {
    /* 400ms is a safe starting point. Default is 200ms */
    tapping-term-ms = <400>; 
    
    /* Optional: Improves fast typing. If you tap, then press-hold quickly, 
       it sends the key again instead of the layer. */
    quick-tap-ms = <175>; 
};

/ {
    // 上下滚动编码器行为

    macros {
        // Types a dot using Alt + 46
        // Types a comma using Alt + 44
    };

    brush_scale_encoder: brush_scale_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&kp LBKT>, <&kp RBKT>;

        tap-ms = <30>;
    };

    zoom_encoder: zoom_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&kp LC(KP_PLUS)>, <&kp LC(KP_MINUS)>;

        tap-ms = <30>;
    };

    // 左右滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc MOVE_Y(400)>, <&msc MOVE_Y(-400)>;

        tap-ms = <30>;
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC             &kp N1        &kp N2        &kp N3       &kp N4    &kp N5     &kp N6    &kp N7     &kp N8         &kp N9          &kp N0          &kp BACKSPACE
&lt 1 TAB           &kp Q         &kp W         &kp E        &kp R     &kp T      &kp Y     &kp U      &kp I          &kp O           &kp P           &kp LEFT_BRACKET
&kp LC(LEFT_SHIFT)  &kp A         &kp S         &kp D        &kp F     &kp G      &kp H     &kp J      &kp K          &kp L           &kp SEMI        &kp SQT
&kp LEFT_SHIFT      &kp Z         &kp X         &kp C        &kp V     &kp B      &kp N     &kp M      &kp COMMA      &kp DOT         &kp UP_ARROW    &kp RIGHT_BRACKET
&kp LEFT_CONTROL    &kp LEFT_WIN  &kp LEFT_ALT  &lt 2 SPACE  &mkp MB1  &kp ENTER  &mkp MB2  &kp SLASH  &kp LS(SLASH)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings =
                <&brush_scale_encoder>,
                <&scroll_vertical_encoder>;
        };

        F_layers {
            bindings = <
&bootloader  &kp F1      &kp F2             &kp F3           &kp F4                &kp F5                &kp F6        &kp F7        &kp F8        &kp F9          &kp F10  &kp DELETE
&trans       &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &bt BT_SEL 2  &out OUT_TOG  &bt BT_CLR    &bt BT_CLR_ALL  &trans   &kp RIGHT_BRACKET
&trans       &none       &none              &none            &none                 &trans                &trans        &trans        &trans        &trans          &trans   &trans
&trans       &trans      &trans             &trans           &trans                &none                 &none         &none         &trans        &trans          &none    &trans
&trans       &trans      &trans             &trans           &trans                &trans                &kp GRAVE     &bt BT_SEL 0  &bt BT_SEL 1  &trans          &trans   &trans
            >;

            sensor-bindings = <&zoom_encoder>, <&scroll_vertical_encoder>;
        };

        BT_layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
